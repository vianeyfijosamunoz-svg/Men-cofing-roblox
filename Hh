local function StartFreecam()
    if isFreecamActive then return end
    isFreecamActive = true
    originalCameraType = Camera.CameraType
    originalCameraSubject = Camera.CameraSubject
    Camera.CameraType = Enum.CameraType.Scriptable
    local camPos = Camera.CFrame.Position
    local camRot = Camera.CFrame
    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not isFreecamActive then return end
        local move = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camRot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camRot.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camRot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camRot.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then
            camPos = camPos + move.Unit * FreecamSpeed * dt
        end
        local mouseDelta = UserInputService:GetMouseDelta()
        local yaw = -mouseDelta.X * 0.003
        local pitch = -mouseDelta.Y * 0.003
        camRot = CFrame.new(camPos) * (camRot - camRot.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
        Camera.CFrame = camRot
    end)
end

local function StopFreecam()
    if not isFreecamActive then return end
    isFreecamActive = false
    if freecamConn then freecamConn:Disconnect() freecamConn = nil end
    Camera.CameraType = originalCameraType or Enum.CameraType.Custom
    if originalCameraSubject then Camera.CameraSubject = originalCameraSubject end
end

