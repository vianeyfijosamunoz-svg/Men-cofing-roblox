    task.delay(0.7, function()
        flash:Destroy()
    end)
end

local lastKnownKills = {}
local function CheckKills()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local kills = GetPlayerStat(plr, {"Kills", "Kill", "kills"})
            lastKnownKills[plr] = kills
        end
    end
    local myKills = GetPlayerStat(LocalPlayer, {"Kills", "Kill", "kills"})
    if lastKnownKills[LocalPlayer] and myKills > lastKnownKills[LocalPlayer] then
        local targetName = CurrentTarget and CurrentTarget.Name or "ENEMY"
        PlayKillEffect(targetName)
    end
    lastKnownKills[LocalPlayer] = myKills
end

