                        local loadoutRemote = remotes:FindFirstChild("Loadout") or remotes:FindFirstChild("EquipLoadout") or remotes:FindFirstChild("SetLoadout")
                        if loadoutRemote and loadoutRemote:IsA("RemoteEvent") then
                            loadoutRemote:FireServer(1)
                        end
                    end
                end)
            end
        end
        if getgenv().AutoRespawnEnabled then
            local char = LocalPlayer.Character
