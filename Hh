        local target = nil
        for _, p in ipairs(Players:GetPlayers()) do if isTargetValid(p) then target = p break end end
        if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = target.Character.HumanoidRootPart
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local angle = (tickCount * (OrbitSpeed * 0.05)) * OrbitAngle
                myRoot.CFrame = hrp.CFrame * CFrame.Angles(0, angle, 0) * CFrame.new(0, OrbitHeight, OrbitStuds)
            end
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local spamOffset = Vector3.new(math.random(-5937473, 5937473), math.random(1000, 5000), math.random(-5937473, 5937473))
                LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(spamOffset) * CFrame.Angles(math.rad(tickCount * 393818), 0, 0)
            end
        end
    end

    if RagebotEnabled then
        RunInstantAutoShot()
        local target = GetClosestTargetPlayer()
        CurrentTarget = target
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            if target and isTargetValid(target) and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local tChar = target.Character
                local tHrp = tChar.HumanoidRootPart
                local optimalHitbox = tChar:FindFirstChild("Head") or tHrp
                local predictedPos = GetPredictedPosition(optimalHitbox)
                local predictedCFrame = CFrame.new(predictedPos)
                if RageMode == "GUN" then
                    local behindCFrame = predictedCFrame * CFrame.new(0, 0, 2)
                    ApplyFakePosition(myRoot, behindCFrame)
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
                elseif RageMode == "MELE" then
                    local backCFrame = predictedCFrame * CFrame.Angles(0, math.rad(180), 0)
                    ApplyFakePosition(myRoot, backCFrame)
                elseif RageMode == "KNIFE" then
                    local lateral = math.sin(tickCount * 0.7) * 1.8
                    ApplyFakePosition(myRoot, predictedCFrame * CFrame.new(lateral, 0, 0.65))
                end
            else
                local spamOffset = Vector3.new(math.random(-9000000, 9000000), math.random(1000, 9000000), math.random(-9000000, 9000000))
                ApplyFakePosition(myRoot, CFrame.new(spamOffset))
            end
        end
    end

    if getgenv().SpinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinbotSpeed), 0)
    end

    if FlightEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        if not flightBodyVelocity or not flightBodyVelocity.Parent then
            flightBodyVelocity = Instance.new("BodyVelocity")
            flightBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flightBodyVelocity.Velocity = Vector3.zero
            flightBodyVelocity.Parent = hrp
        end
        if not flightBodyGyro or not flightBodyGyro.Parent then
            flightBodyGyro = Instance.new("BodyGyro")
            flightBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            flightBodyGyro.P = 9e4
            flightBodyGyro.Parent = hrp
        end
        local move = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
        if move.Magnitude > 0 then
            flightBodyVelocity.Velocity = move.Unit * FlightSpeed
        else
            flightBodyVelocity.Velocity = Vector3.zero
        end
        flightBodyGyro.CFrame = camCF
    else
        if LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end
        if flightBodyVelocity then flightBodyVelocity:Destroy() flightBodyVelocity = nil end
        if flightBodyGyro then flightBodyGyro:Destroy() flightBodyGyro = nil end
    end
end)

